[Unit]
Description=Omni app (resident so the quick-ask popover opens instantly)
After=graphical-session.target omnid.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omni app-background
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
